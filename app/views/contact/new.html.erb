<% content_for :title, t("contact_form.meta_title") %>
<% content_for :description, t("contact_form.meta_description") %>

<section class="hero hero--small">
  <%= breadcrumbs([ t("contact_form.title"), contact_url ]) %>
  <h1><%= t("contact_form.heading") %></h1>
  <p class="lead"><%= t("contact_form.lead") %></p>
</section>

<div class="block contact-layout">
  <div class="contact-main">
    <%= form_with model: @request, url: contact_path, method: :post, class: "contact-form", local: true do |f| %>
      <% if @request.errors.any? %>
        <div class="form-alert form-alert--error" role="alert">
          <strong><%= t("contact_form.errors_header") %></strong>
          <ul>
            <% @request.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Honeypot anti-spam (invisível para humanos) -->
      <div class="form-hp" aria-hidden="true" style="display:none !important;">
        <%= f.label :honeypot, "Deixe em branco se for humano" %>
        <%= f.text_field :honeypot, tabindex: "-1", autocomplete: "off" %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :name, t("contact_form.fields.name"), class: "form-label" %>
          <%= f.text_field :name, class: "form-input", placeholder: t("contact_form.placeholders.name"), required: true, maxlength: 100 %>
        </div>

        <div class="form-group">
          <%= f.label :email, t("contact_form.fields.email"), class: "form-label" %>
          <%= f.email_field :email, class: "form-input", placeholder: t("contact_form.placeholders.email"), required: true, maxlength: 120 %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :contact_handle, t("contact_form.fields.contact_handle"), class: "form-label" %>
        <%= f.text_field :contact_handle, class: "form-input", placeholder: t("contact_form.placeholders.contact_handle"), maxlength: 100 %>
        <span class="form-hint"><%= t("contact_form.hints.contact_handle") %></span>
      </div>

      <fieldset class="form-group">
        <legend class="form-label"><%= t("contact_form.fields.services") %></legend>
        <span class="form-hint"><%= t("contact_form.hints.services") %></span>
        <div class="form-chips">
          <% ContactRequest::AVAILABLE_SERVICES.each do |svc| %>
            <label class="form-chip">
              <%= f.check_box :services, { multiple: true, class: "form-chip__input" }, svc, nil %>
              <span class="form-chip__label"><%= t("contact_form.services.#{svc}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="form-group">
        <legend class="form-label"><%= t("contact_form.fields.budget") %></legend>
        <span class="form-hint"><%= t("contact_form.hints.budget") %></span>
        <div class="form-chips">
          <% ContactRequest::AVAILABLE_BUDGETS.each do |bg| %>
            <label class="form-chip">
              <%= f.radio_button :budget, bg, class: "form-chip__input" %>
              <span class="form-chip__label"><%= t("contact_form.budgets.#{bg}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="form-group">
        <legend class="form-label"><%= t("contact_form.fields.timeline") %></legend>
        <div class="form-chips">
          <% ContactRequest::AVAILABLE_TIMELINES.each do |tl| %>
            <label class="form-chip">
              <%= f.radio_button :timeline, tl, class: "form-chip__input" %>
              <span class="form-chip__label"><%= t("contact_form.timelines.#{tl}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="form-group">
        <%= f.label :details, t("contact_form.fields.details"), class: "form-label" %>
        <%= f.text_area :details, class: "form-textarea", rows: 5, placeholder: t("contact_form.placeholders.details"), required: true, minlength: 10, maxlength: 4000 %>
        <span class="form-hint"><%= t("contact_form.hints.details") %></span>
      </div>

      <div class="form-actions">
        <%= f.submit t("contact_form.submit"), class: "button button--primary button--lg" %>
        <p class="form-privacy mono">
          <%= t("contact_form.privacy_note") %>
        </p>
      </div>
    <% end %>
  </div>

  <aside class="contact-aside">
    <div class="contact-card">
      <h3 class="mono"><%= t("contact_form.direct_title") %></h3>
      <p class="muted"><%= t("contact_form.direct_intro") %></p>
      <ul class="sources--channels" aria-label="<%= t("contact.label") %>">
        <li>
          <a href="mailto:<%= contact["email"] %>">
            <span class="ch-icon ch-icon--email"></span>
            <span class="mono"><%= contact["email"] %></span>
          </a>
        </li>
        <li>
          <a href="<%= whatsapp_url %>" target="_blank" rel="noopener">
            <span class="ch-icon ch-icon--whatsapp"></span>
            <span class="mono">WhatsApp <%= whatsapp_label %></span>
          </a>
        </li>
        <li>
          <a href="<%= contact["linkedin"] %>" target="_blank" rel="noopener">
            <span class="ch-icon ch-icon--linkedin"></span>
            <span class="mono">LinkedIn</span>
          </a>
        </li>
      </ul>

      <div class="contact-promise">
        <span class="contact-promise__badge mono">⚡ <%= t("contact_form.promise_badge") %></span>
        <p class="muted"><%= t("contact_form.promise_text") %></p>
      </div>
    </div>
  </aside>
</div>
