<% content_for :title, localized_site("headline") %>
<script type="application/ld+json"><%= raw organization_json_ld %></script>

<section class="hero">
  <p class="mono"><%= t("home.kicker") %></p>
  <h1><%= localized_site("headline") %></h1>
  <p class="lead"><%= localized_site("description") %></p>
  <p class="cta">
    <a class="button button--primary" href="mailto:<%= contact["email"] %>"><%= t("contact.email") %></a>
    <a class="button" href="<%= whatsapp_url %>" target="_blank" rel="noopener"><%= t("contact.whatsapp") %></a>
    <a class="button" href="<%= contact["linkedin"] %>" target="_blank" rel="noopener">LinkedIn</a>
  </p>
  <p class="cta-note mono"><%= t("contact.response") %></p>
</section>

<section aria-labelledby="pillars-title" class="block">
  <h2 id="pillars-title" class="mono"><%= t("home.pillars") %></h2>
  <ul class="pillars">
    <% site["pillars"].each do |pillar| %>
      <li>
        <strong><%= localized(pillar["title"]) %></strong>
        <span><%= localized(pillar["text"]) %></span>
      </li>
    <% end %>
  </ul>
</section>

<% if founder_entry %>
  <section class="block founder-card" aria-labelledby="founder-title">
    <img src="<%= founder_entry.photo["small"] %>" width="120" height="180" alt="<%= founder_entry.photo_alt(I18n.locale) %>" loading="lazy" decoding="async">
    <div>
      <h2 id="founder-title" class="mono"><%= t("home.founder_kicker") %></h2>
      <p><strong><%= site["founder"]["name"] %></strong> — <%= founder_entry.title(I18n.locale).split(" — ").last %></p>
      <p class="muted"><%= meta_description(founder_entry.about(I18n.locale).first, limit: 200) %></p>
      <p><a href="<%= entry_path(folder: founder_entry.folder, slug: founder_entry.id) %>"><%= t("home.founder_link") %> →</a></p>
    </div>
  </section>
<% end %>

<% @folders.each do |folder, entries| %>
  <section class="block" aria-labelledby="f-<%= folder %>">
    <h2 id="f-<%= folder %>"><a href="<%= folder_path(folder: folder) %>"><%= t("folders.#{folder}") %></a></h2>
    <p class="muted"><%= t("folder_intro.#{folder}") %></p>
    <ul class="rows">
      <%= render partial: "shared/entry_row", collection: entries, as: :entry %>
    </ul>
  </section>
<% end %>
