{
  // The Usami site on Cloudflare's free plan: static files plus one small Worker (assistant, cookie choice, "/" redirect).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usami",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // Written by `rails static:export` (see README.md).
    "directory": "./site",
    "binding": "ASSETS",
    // /pt serves pt.html, /pt/sistemas serves pt/sistemas.html: the same addresses the Rails app used.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run code; everything else is served as a file.
    "run_worker_first": [
      "/",
      "/pt/assistant", "/en/assistant", "/es/assistant", "/ja/assistant",
      "/pt/consentimento", "/en/consentimento", "/es/consentimento", "/ja/consentimento",
      // the quote form is a static page that posts here; the Worker emails the request
      "/pt/contato", "/en/contato", "/es/contato", "/ja/contato"
    ]
  },
  // The AI provider key and the email key are secrets (npx wrangler secret put NVIDIA_API_KEY / RESEND_API_KEY), never written here.
  "vars": { "NVIDIA_MODEL": "poolside/laguna-xs-2.1", "DAILY_LIMIT": "400", "CONTACT_TO": "devreskyume@gmail.com" },
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }]
}